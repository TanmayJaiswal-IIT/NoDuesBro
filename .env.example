# Local Postgres started with npm run db:up.
# Replace with a Neon connection string when the project is linked.
# Hosts ending in neon.tech use the Neon HTTP driver. Other hosts use node-postgres.
DATABASE_URL=postgresql://found:found@127.0.0.1:54329/found

# Used only to rebuild seed extractions. Leave empty here. Put the real key in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=
